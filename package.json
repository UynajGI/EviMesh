{
  "name": "evimesh",
  "version": "0.3.0",
  "private": true,
  "description": "EviMesh 开放分布式科研推进网络",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "lint": "turbo run lint",
    "infra:up": "node scripts/dev-infra.mjs",
    "demo:api": "node scripts/demo-stack.mjs",
    "demo:web": "node scripts/demo-web.mjs",
    "docs:reference": "node scripts/generate-docs-reference.mjs",
    "docs:reference:check": "node scripts/generate-docs-reference.mjs --check",
    "infra:doctor": "node scripts/infra-doctor.mjs",
    "infra:hosted-readiness": "node scripts/hosted-readiness.mjs",
    "auth:test:email": "node scripts/test-supabase-email-auth.mjs",
    "package:build": "node scripts/build-npm-distributions.mjs",
    "package:test": "node scripts/test-npm-tarballs.mjs",
    "validate": "turbo run lint",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lefthook": "^2.1.10",
    "playwright": "^1.62.1",
    "turbo": "^2.10.11"
  },
  "pnpm": {
    "overrides": {
      "nanoid@^3.0.0": "3.3.18"
    }
  }
}
