{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evimesh.org/schema/dataset.schema.json",
  "title": "EviMesh Dataset revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dataset_id", "project_id", "revision", "supersedes_revision", "state", "name", "description", "version", "license", "schema_uri", "provenance", "artifact_ref", "created_at", "created_by"],
  "properties": {
    "schema": { "const": "srp.dataset.v1" },
    "dataset_id": { "type": "string", "pattern": "^dataset_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "project_id": { "type": "string", "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes_revision": { "type": ["integer", "null"], "minimum": 1 },
    "state": { "$ref": "#/$defs/state" },
    "name": { "type": "string", "minLength": 1, "maxLength": 500 },
    "description": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "version": { "type": "string", "minLength": 1, "maxLength": 200 },
    "license": { "type": "string", "minLength": 1, "maxLength": 500 },
    "schema_uri": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 },
    "provenance": { "type": "string", "minLength": 1, "maxLength": 20000 },
    "artifact_ref": { "$ref": "#/$defs/artifactRef" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  },
  "allOf": [{
    "if": { "properties": { "revision": { "const": 1 } }, "required": ["revision"] },
    "then": { "properties": { "supersedes_revision": { "const": null } } },
    "else": { "properties": { "supersedes_revision": { "type": "integer", "minimum": 1 } } }
  }],
  "$defs": {
    "state": { "type": "string", "enum": ["draft", "published", "superseded", "retracted"] },
    "artifactRef": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision"], "properties": { "kind": { "const": "artifact" }, "id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 } } }
  }
}
