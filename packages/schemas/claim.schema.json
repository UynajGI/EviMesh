{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evimesh.org/schema/claim.schema.json",
  "title": "EviMesh Claim revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "claim_id", "revision", "state", "statement", "scope", "assumptions", "falsification", "created_at", "created_by"],
  "properties": {
    "schema": { "const": "srp.claim.v1" },
    "claim_id": { "type": "string", "pattern": "^claim_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "type": "string", "enum": ["hypothesis", "candidate", "under_verification", "provisionally_accepted", "accepted", "contested", "refuted", "superseded", "retracted", "dependency_tainted"] },
    "statement": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "falsification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "question_id": { "type": "string", "pattern": "^question_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  }
}
