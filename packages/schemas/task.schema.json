{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evimesh.org/schema/task.schema.json",
  "title": "EviMesh Task revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "revision", "state", "title", "description", "inputs", "outputs", "acceptance", "context_mode", "created_at", "created_by"],
  "properties": {
    "schema": { "const": "srp.task.v1" },
    "task_id": { "type": "string", "pattern": "^task_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "type": "string", "enum": ["draft", "open", "active", "blocked", "verification_requested", "completed", "cancelled"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/artifactSpec" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifactSpec" } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "task_type": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "context_mode": { "type": "string", "enum": ["frontier", "full_trace", "adversarial", "blind"] },
    "question_id": { "type": "string", "pattern": "^question_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "artifactSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" }
      }
    }
  }
}
