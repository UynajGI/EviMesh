{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evimesh.org/schema/evaluation.schema.json",
  "title": "EviMesh Evaluation revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evaluation_id", "project_id", "revision", "supersedes_revision", "state", "subject_ref", "basis_refs", "stance", "rationale", "method", "created_at", "created_by"],
  "properties": {
    "schema": { "const": "srp.evaluation.v1" },
    "evaluation_id": { "type": "string", "pattern": "^evaluation_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "project_id": { "type": "string", "pattern": "^project_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes_revision": { "type": ["integer", "null"], "minimum": 1 },
    "state": { "$ref": "#/$defs/state" },
    "subject_ref": { "$ref": "#/$defs/subjectRef" },
    "basis_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/basisRef" } },
    "stance": { "type": "string", "enum": ["supports", "refutes", "qualifies", "reproduces", "verifies"] },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 50000 },
    "method": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  },
  "allOf": [{
    "if": { "properties": { "revision": { "const": 1 } }, "required": ["revision"] },
    "then": { "properties": { "supersedes_revision": { "const": null } } },
    "else": { "properties": { "supersedes_revision": { "type": "integer", "minimum": 1 } } }
  }],
  "$defs": {
    "state": { "type": "string", "enum": ["draft", "published", "superseded", "retracted"] },
    "subjectRef": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision"], "properties": { "kind": { "const": "claim" }, "id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 } } },
    "basisRef": { "type": "object", "additionalProperties": false, "required": ["kind", "id", "revision"], "properties": { "kind": { "type": "string", "enum": ["claim", "evidence", "run", "dataset", "artifact"] }, "id": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 } } }
  }
}
