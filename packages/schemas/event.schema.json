{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evimesh.org/schema/event.schema.json",
  "title": "EviMesh ResearchEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "event_id", "event_type", "payload", "hash", "signature", "parents"],
  "properties": {
    "schema": { "const": "srp.event.v1" },
    "event_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "event_type": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$" },
    "payload": { "type": "object", "minProperties": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": { "$ref": "#/$defs/signature" },
    "parents": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }, "uniqueItems": true }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
