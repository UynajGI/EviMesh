{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evimesh.org/schema/question.schema.json",
  "title": "EviMesh Question revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "question_id", "revision", "state", "title", "statement", "research_contract", "created_at", "created_by"],
  "properties": {
    "schema": { "const": "srp.question.v1" },
    "question_id": { "type": "string", "pattern": "^question_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "type": "string", "enum": ["draft", "proposed", "under_review", "admissible", "active", "resolved", "archived", "rejected"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "statement": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "research_contract": { "$ref": "#/$defs/researchContract" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "researchContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem", "definitions", "background", "scope", "progress_criteria", "acceptable_evidence", "falsification", "license", "risk_level", "maintainer_ids"],
      "properties": {
        "problem": { "type": "string", "minLength": 1 },
        "definitions": { "type": "object", "minProperties": 1 },
        "background": { "type": "string", "minLength": 1 },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "progress_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "acceptable_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "falsification": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "license": { "type": "string", "minLength": 1 },
        "risk_level": { "type": "string", "enum": ["open", "moderated", "restricted", "prohibited"] },
        "maintainer_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    }
  }
}
