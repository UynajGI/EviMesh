{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evimesh-mirror-worker-dev",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-04",
  "vars": {
    "EVIMESH_ENV": "development",
    "GITHUB_MIRROR_OWNER": "UynajGI",
    "GITHUB_MIRROR_REPO": "EviMesh-frontiers"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "env": {
    "staging": {
      "name": "evimesh-mirror-worker-staging",
      "vars": {
        "EVIMESH_ENV": "staging",
        "GITHUB_MIRROR_OWNER": "UynajGI",
        "GITHUB_MIRROR_REPO": "EviMesh-frontiers"
      }
    },
    "production": {
      "name": "evimesh-mirror-worker",
      "vars": {
        "EVIMESH_ENV": "production",
        "GITHUB_MIRROR_OWNER": "UynajGI",
        "GITHUB_MIRROR_REPO": "EviMesh-frontiers"
      }
    }
  }
}
