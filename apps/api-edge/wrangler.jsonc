{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evimesh-api-edge-dev",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "evimesh-dev"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimitDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "m13-rate-limit-v1", "new_sqlite_classes": ["RateLimitDurableObject"] }
  ],
  "vars": {
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,https://dev.evimesh.com",
    "EVIMESH_WEB_URL": "http://localhost:3000",
    "EVIMESH_ENV": "development",
    "EVIMESH_RELEASE_CHANNEL": "preview",
    "EVIMESH_DEVICE_AUTH_ENABLED": "false",
    "EVIMESH_RESEARCH_PREPARE_ENABLED": "false",
    "EVIMESH_RESEARCH_SUBMIT_ENABLED": "false",
    "EVIMESH_TYPED_RESEARCH_ATOMIC_RPC_READY": "false",
    "ACTOR_RATE_LIMIT_MAX": "120",
    "API_TOKEN_RATE_LIMIT_MAX": "60",
    "RATE_LIMIT_WINDOW_SECONDS": "60",
    "RESEARCH_GRAPH_READ_MODE": "legacy",
    "RESEARCH_GRAPH_WRITE_MODE": "legacy",
    "RESEARCH_GRAPH_CUTOVER_READY": "false",
    "GITHUB_MIRROR_OWNER": "UynajGI",
    "GITHUB_MIRROR_REPO": "EviMesh-frontiers",
    "SUPABASE_URL": "http://127.0.0.1:54321"
  },
  "env": {
    "staging": {
      "name": "evimesh-api-edge-staging",
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimitDurableObject" }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "evimesh-staging"
        }
      ],
      "vars": {
        "CORS_ALLOWED_ORIGINS": "https://dev.evimesh.com",
        "EVIMESH_WEB_URL": "https://dev.evimesh.com",
        "EVIMESH_ENV": "staging",
        "EVIMESH_RELEASE_CHANNEL": "preview",
        "EVIMESH_DEVICE_AUTH_ENABLED": "false",
        "EVIMESH_RESEARCH_PREPARE_ENABLED": "false",
        "EVIMESH_RESEARCH_SUBMIT_ENABLED": "false",
        "EVIMESH_TYPED_RESEARCH_ATOMIC_RPC_READY": "false",
        "ACTOR_RATE_LIMIT_MAX": "120",
        "API_TOKEN_RATE_LIMIT_MAX": "60",
        "RATE_LIMIT_WINDOW_SECONDS": "60",
        "RESEARCH_GRAPH_READ_MODE": "legacy",
        "RESEARCH_GRAPH_WRITE_MODE": "legacy",
        "RESEARCH_GRAPH_CUTOVER_READY": "false",
        "GITHUB_MIRROR_OWNER": "UynajGI",
        "GITHUB_MIRROR_REPO": "EviMesh-frontiers",
        "SUPABASE_URL": "https://qotwxdhzpoubniqdhskl.supabase.co"
      }
    },
    "production": {
      "name": "evimesh-api-edge",
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimitDurableObject" }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ARTIFACTS",
          "bucket_name": "evimesh-production"
        }
      ],
      "vars": {
        "CORS_ALLOWED_ORIGINS": "https://evimesh.com",
        "EVIMESH_WEB_URL": "https://evimesh.com",
        "EVIMESH_ENV": "production",
        "EVIMESH_RELEASE_CHANNEL": "preview",
        "EVIMESH_DEVICE_AUTH_ENABLED": "true",
        "EVIMESH_RESEARCH_PREPARE_ENABLED": "false",
        "EVIMESH_RESEARCH_SUBMIT_ENABLED": "false",
        "EVIMESH_TYPED_RESEARCH_ATOMIC_RPC_READY": "false",
        "ACTOR_RATE_LIMIT_MAX": "120",
        "API_TOKEN_RATE_LIMIT_MAX": "60",
        "RATE_LIMIT_WINDOW_SECONDS": "60",
        "RESEARCH_GRAPH_READ_MODE": "legacy",
        "RESEARCH_GRAPH_WRITE_MODE": "legacy",
        "RESEARCH_GRAPH_CUTOVER_READY": "false",
        "GITHUB_MIRROR_OWNER": "UynajGI",
        "GITHUB_MIRROR_REPO": "EviMesh-frontiers",
        "SUPABASE_URL": "https://rruhruccjnuffodfbkuh.supabase.co"
      }
    }
  }
}
