# Environment: development | staging | production
EVIMESH_ENV=development

# Local Compose ports
EVIMESH_POSTGRES_PORT=5432
EVIMESH_S3_PORT=9000
EVIMESH_S3_CONSOLE_PORT=9001
EVIMESH_SMTP_PORT=1025
EVIMESH_MAILPIT_PORT=8025

# Local PostgreSQL
DATABASE_URL=postgresql://evimesh:evimesh_local_only@127.0.0.1:5432/evimesh_dev

# Local S3-compatible storage (MinIO)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=evimesh_minio
S3_SECRET_ACCESS_KEY=evimesh_minio_local_only
S3_BUCKET=evimesh-dev

# Supabase (development / staging / production values are platform secrets)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated

# Browser-safe Web configuration (public values only)
NEXT_PUBLIC_EVIMESH_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ORCID_PROVIDER=custom:orcid

# Cloudflare R2 / Workers
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Runtime endpoints used by infra:doctor
EVIMESH_API_URL=http://127.0.0.1:8787/health
EVIMESH_WEB_URL=http://127.0.0.1:3000

# Hosted origin placeholders (set in staging/production only)
EVIMESH_WEB_DEV_ORIGIN=
EVIMESH_WEB_PRODUCTION_ORIGIN=
EVIMESH_API_PRODUCTION_ORIGIN=
